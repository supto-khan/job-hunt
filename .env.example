# ─── MySQL / MariaDB Database Credentials ───
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=job_hunter

# ─── Required for JSearch (LinkedIn/Indeed/Glassdoor aggregator) ───
# Sign up: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier: 200 requests/month
RAPIDAPI_KEY=

# ─── Required for Daily Email Digest ───
# Must use Gmail App Password, NOT your regular password
# Generate at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification enabled first)
SENDER_EMAIL=
SENDER_APP_PASSWORD=
RECIPIENT_EMAIL=

# ─── Daily Digest Timing (BST / Bangladesh Standard Time) ───
DAILY_EMAIL_HOUR=10
DAILY_EMAIL_TIMEZONE=Asia/Dhaka
DAILY_JOBS_COUNT=15

# ─── Optional: Hunter.io (not actively used — LinkedIn search replaces it) ───
HUNTER_API_KEY=

# ─── Optional: Google Sheets Export ───
GOOGLE_SHEETS_CREDS=credentials.json
GOOGLE_SHEET_ID=

# ─── Free AI Providers (Gemini / Groq with Automatic Fallback) ───
# Primary: Google Gemini API (Free tier: 15 req/min, 1500 req/day)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=

# Secondary Fallback: Groq API (Free tier: Llama 3 models)
# Get key: https://console.groq.com/
GROQ_API_KEY=

# ─── Notifications (Discord Webhooks & Telegram Bot) ───
# Discord: Webhook URL created in Channel Settings -> Integrations
DISCORD_WEBHOOK_URL=

# Telegram: Bot Token from @BotFather + your User/Group Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Min relevance score to trigger instant push notifications (default: 80)
NOTIFY_MIN_SCORE=80

# ─── Legacy / Future Use (not used currently) ───
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SERPAPI_KEY=
